<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1E232B" />
            <stroke android:width="2dp" android:color="#3B6FE0" />
        </shape>
    </item>
    <!-- Inner face -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#171A1F" />
            <stroke android:width="1dp" android:color="#262B33" />
        </shape>
    </item>
</layer-list>
